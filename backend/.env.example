AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_NAME=wizway-scheduler
CAMPAIGN_ID=current
# ローカルのみ true。AWS デプロイの既定は false
ALLOW_DEV_RESEED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ローカルのみ true（/docs /redoc /openapi.json）。AWS 既定は false
ENABLE_API_DOCS=true

# --- Slack OAuth（Sign in with Slack）---
# Slack App の Client ID / Secret（OAuth & Permissions）
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=your-slack-client-secret
# フロントのコールバック（Slack App の Redirect URLs にも同値を登録）
SLACK_REDIRECT_URI=http://localhost:5173/auth/slack/callback
# 追加の許可 redirect_uri（カンマ区切り・任意）
# SLACK_REDIRECT_URI_ALLOWLIST=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net/auth/slack/callback
# 社内ワークスペース ID（一致しないと denied）。実 ID はローカル .env にのみ書く
SLACK_TEAM_ID=T0000000000
# 管理者マスター（全画面）。カンマ区切りの Slack user_id（プレースホルダ）
SLACK_ADMIN_USER_IDS=U_ADMIN_1,U_ADMIN_2
# Mgr・コーディネータ（/mgr のみ）。カンマ区切りの Slack user_id（プレースホルダ）
SLACK_MGR_USER_IDS=U_MGR_1,U_MGR_2,U_COORDINATOR
# セッション署名鍵（ローカル用の例。本番は必ず強力なランダム値をデプロイ時に渡す。Git に本番値を書かない）
AUTH_SESSION_SECRET=dev-auth-session-secret-change-me
AUTH_SESSION_TTL_SECONDS=604800
# 開発用クイックログイン（/auth/dev/login）。ローカル true / AWS 既定 false
ALLOW_DEV_AUTH=true

# Slack 通知
# 開発・検証中は SLACK_TEST_MODE=true で全通知をテスト用チャンネルへ集約する
SLACK_TEST_MODE=true
# テスト集約先チャンネル ID（プレースホルダ）
SLACK_TEST_CHANNEL_ID=C0000000000
# true（既定）: 外部 HTTP 抑止（ログのみ）。false: Webhook / Bot Token で実送信
SLACK_DRY_RUN=true
# true: 本文先頭に宛先ラベルを付与。本番切替後は false で外す
SLACK_DESTINATION_LABELS=true
# Bot Token（chat.postMessage）。Webhook を使う場合は SLACK_WEBHOOK_URL を設定
# SLACK_BOT_TOKEN=xoxb-example-mock-token
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/MOCK/LOCAL

# ルート別送信先（プレースホルダ。ローカル .env で実 ID を設定）
SLACK_CHANNEL_MEGURO=C0000000000
SLACK_CHANNEL_YAMAMOTO=C0000000000
SLACK_CHANNEL_ISHIBASHI=C0000000000
SLACK_CHANNEL_TANAKA=C0000000000
SLACK_CHANNEL_HAMADA=C0000000000
SLACK_CHANNEL_SALES=C0000000000
