# Copy to .deploy-secrets.ps1 (gitignored) and fill from your local backend/.env
#   Copy-Item .deploy-secrets.ps1.example .deploy-secrets.ps1
#   . .\.deploy-secrets.ps1
#   sam deploy --parameter-overrides "AllowDevAuth=false ... CorsOrigins=$env:CORS_ORIGINS AuthSessionSecret=$env:AUTH_SESSION_SECRET SlackTeamId=$env:SLACK_TEAM_ID ..."

$env:AUTH_SESSION_SECRET = 'replace-with-strong-random-secret-at-least-32-chars'
$env:CORS_ORIGINS = 'https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net'
$env:SLACK_TEAM_ID = 'T0000000000'
$env:SLACK_TEST_CHANNEL_ID = 'C0000000000'
$env:SLACK_CHANNEL_MEGURO = 'C0000000000'
$env:SLACK_CHANNEL_YAMAMOTO = 'C0000000000'
$env:SLACK_CHANNEL_ISHIBASHI = 'C0000000000'
$env:SLACK_CHANNEL_TANAKA = 'C0000000000'
$env:SLACK_CHANNEL_HAMADA = 'C0000000000'
$env:SLACK_CHANNEL_SALES = 'C0000000000'
$env:SLACK_CLIENT_ID = '1234567890.1234567890'
$env:SLACK_CLIENT_SECRET = 'your-slack-client-secret'
$env:SLACK_REDIRECT_URI = 'https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net/auth/slack/callback'
$env:SLACK_BOT_TOKEN = 'xoxb-example-mock-token'
$env:VITE_API_BASE = 'https://YOUR_API_ID.execute-api.ap-northeast-1.amazonaws.com/api/v1'
$env:VITE_SLACK_CLIENT_ID = '1234567890.1234567890'
