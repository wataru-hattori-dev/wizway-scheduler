# API（Vite プロキシ経由ならデフォルトのまま）
VITE_API_BASE=/api/v1
VITE_USE_API=true

# CloudFront 配信ビルド例（実 URL は書かず、デプロイ時に環境変数で渡す）:
# VITE_API_BASE=https://YOUR_API_ID.execute-api.ap-northeast-1.amazonaws.com/api/v1
# VITE_SLACK_REDIRECT_URI=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net/auth/slack/callback

# Slack OAuth（フロント表示・コールバック用。秘密情報は backend 側）
# Client ID は公開前提だが、リポジトリにはプレースホルダのみ置く
VITE_SLACK_CLIENT_ID=1234567890.1234567890
VITE_SLACK_REDIRECT_URI=http://localhost:5173/auth/slack/callback
